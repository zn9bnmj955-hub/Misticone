{
  "name": "orgasport",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @orgasport/web dev",
    "build": "pnpm --filter @orgasport/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @orgasport/web test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "seed:gen": "pnpm --filter @orgasport/db seed:gen",
    "test:db": "PGPASSWORD=postgres psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -q -f supabase/tests/rls.sql",
    "videos:render": "pnpm --filter @orgasport/videos render",
    "videos:studio": "pnpm --filter @orgasport/videos studio"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "supabase": "2.120.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
