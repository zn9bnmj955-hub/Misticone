# =============================================================================
# OrgaSport — variables d'environnement
# Copie ce fichier en apps/web/.env.local (développement) ou renseigne ces
# variables chez l'hébergeur (production). Ne mets JAMAIS de vraie clé dans
# le code ni dans ce fichier.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Adresse publique du site (sert aux liens des emails, QR codes, retours Stripe).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (base de données, comptes, temps réel, fichiers) ----------------
# En local : valeurs affichées par `pnpm db:start`.
# En production : Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clé « publishable » : peut être visible dans le navigateur (protégée par la RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé « secret » : SERVEUR UNIQUEMENT. Contourne la RLS. Ne jamais l'exposer.
SUPABASE_SECRET_KEY=

# --- Connexion ---------------------------------------------------------------
# Fournisseurs affichés sur l'écran de connexion, séparés par des virgules.
# Valeurs possibles : google, apple. Vide = email seulement.
# Chaque fournisseur doit aussi être activé dans Supabase > Authentication > Providers.
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- Anti-robots (Cloudflare Turnstile, gratuit) -------------------------------
# Vide = désactivé (développement). La clé secrète se configure dans
# Supabase > Authentication > Attack Protection (pas ici).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Table de marque ---------------------------------------------------------
# Signe les sessions des bénévoles connectés par code PIN. Une longue chaîne
# aléatoire (ex. résultat de `openssl rand -hex 32`). SERVEUR UNIQUEMENT.
STAFF_SESSION_SECRET=
# Protège l'adresse /api/cron/tick appelée chaque minute par un service de
# tâches planifiées (tirages automatiques à l'heure prévue).
CRON_SECRET=

# --- Paiement (Stripe) ---------------------------------------------------------
# Clé secrète Stripe (mode test : commence par sk_test_). SERVEUR UNIQUEMENT.
# Vide = en développement, un « paiement simulé » local remplace Stripe
# (jamais en production : sans clé, le paiement est simplement indisponible).
STRIPE_SECRET_KEY=
# Secret de signature des webhooks (commence par whsec_). Donné par
# `stripe listen` en local, ou par Stripe > Développeurs > Webhooks en production.
# En développement sans Stripe, mettez n'importe quelle longue chaîne : elle
# signe les paiements simulés.
STRIPE_WEBHOOK_SECRET=

# --- Emails ----------------------------------------------------------------------
# Clé Resend (3 000 emails/mois gratuits). Vide = en développement, les emails
# arrivent dans la boîte de test locale http://127.0.0.1:54324.
RESEND_API_KEY=
# Expéditeur des emails (domaine vérifié chez Resend en production).
EMAIL_FROM="OrgaSport <noreply@exemple.fr>"

# --- Notifications push (Web Push, gratuit) --------------------------------------
# Paire de clés VAPID : générez-la une fois avec `npx web-push generate-vapid-keys`.
# La clé publique peut être visible dans le navigateur ; la clé privée JAMAIS.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact obligatoire pour les services de push (mailto: ou adresse du site).
VAPID_SUBJECT=mailto:contact@exemple.fr

# --- Assistant IA (Anthropic) ------------------------------------------------------
# Clé API Anthropic (console.anthropic.com > API Keys). SERVEUR UNIQUEMENT.
# Vide = l'assistant répond seulement avec la base de connaissances du site.
ANTHROPIC_API_KEY=
# Modèle (facultatif) : prioritaire sur le réglage de l'administration.
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Anti-robots côté serveur (Cloudflare Turnstile) -----------------------------
# Clé secrète Turnstile pour le formulaire d'inscription aux concours.
# Avec NEXT_PUBLIC_TURNSTILE_SITE_KEY : vérification obligatoire. Vide = désactivé.
TURNSTILE_SECRET_KEY=

# --- Météo et cartes ---------------------------------------------------------------
# MET Norway exige un User-Agent qui identifie le site (nom + adresse ou email).
WEATHER_USER_AGENT="OrgaSport/1.0 (+https://exemple.fr)"
# Tuiles de carte (facultatif). Vide = OpenStreetMap, à remplacer par un
# fournisseur (MapTiler, Stadia…) si le trafic augmente. {z}/{x}/{y} obligatoires.
# NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
