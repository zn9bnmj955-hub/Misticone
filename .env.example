# =============================================================================
# OrgaSport — variables d'environnement
# Copie ce fichier en apps/web/.env.local (développement) ou renseigne ces
# variables chez l'hébergeur (production). Ne mets JAMAIS de vraie clé dans
# le code ni dans ce fichier.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Adresse publique du site (sert aux liens des emails, QR codes, retours Stripe).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (base de données, comptes, temps réel, fichiers) ----------------
# En local : valeurs affichées par `pnpm db:start`.
# En production : Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clé « publishable » : peut être visible dans le navigateur (protégée par la RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé « secret » : SERVEUR UNIQUEMENT. Contourne la RLS. Ne jamais l'exposer.
SUPABASE_SECRET_KEY=

# --- Connexion ---------------------------------------------------------------
# Fournisseurs affichés sur l'écran de connexion, séparés par des virgules.
# Valeurs possibles : google, apple. Vide = email seulement.
# Chaque fournisseur doit aussi être activé dans Supabase > Authentication > Providers.
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- Anti-robots (Cloudflare Turnstile, gratuit) -------------------------------
# Vide = désactivé (développement). La clé secrète se configure dans
# Supabase > Authentication > Attack Protection (pas ici).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Paiement (Stripe, phase 3) -----------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Emails (Resend, phase 5) --------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM="OrgaSport <noreply@exemple.fr>"

# --- Notifications push (phase 5) ----------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Assistant IA (Anthropic, phase 6) -----------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
